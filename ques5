class Cart {
    private final String cartId;
    private final int[] prices;
    private int count;

    Cart(String cartId, int capacity) {
        this.cartId = cartId;
        this.prices = new int[capacity];
    }

    boolean addItem(int price) {
        if (count == prices.length) return false;
        prices[count++] = price;
        return true;
    }

    int getTotal() {
        int total = 0;
        for (int i = 0; i < count; i++) total += prices[i];
        return total;
    }

    int getItemCount() {
        return count;
    }

    String getCartId() {
        return cartId;
    }
}

public class Main {
    public static void main(String[] args) {
        Cart cart = new Cart("CART-5", 20);
        cart.addItem(250);
        cart.addItem(99);
        cart.addItem(151);
        System.out.println(cart.getTotal());
        System.out.println(cart.getItemCount());
    }
}
